# Server Port (Render sets this automatically — do not hardcode in production)
PORT=4000

# Set to "production" on Render
NODE_ENV=production

# JWT secret (use a long random string in production)
JWT_SECRET=replace_with_a_long_random_secret_string

# MongoDB Atlas connection string
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Only needed when the frontend is on a different origin (not for the Vercel services setup)
# Add comma-separated values for multiple origins
CORS_ORIGIN=https://your-erp-portal.vercel.app
